diff --git a/submodules/MTProtoRustEngine/Sources/MTProtoRustEngine/MieruStreamHost.swift b/submodules/MTProtoRustEngine/Sources/MTProtoRustEngine/MieruStreamHost.swift
new file mode 100644
index 0000000..2c8777c
--- /dev/null
+++ b/submodules/MTProtoRustEngine/Sources/MTProtoRustEngine/MieruStreamHost.swift
@@ -0,0 +1,96 @@
+import Foundation
+import MieruTransport
+import MTProtoEngineFFI
+
+final class MieruStreamHost {
+    private let engine: OpaquePointer
+    private let queue = DispatchQueue(label: "Telegramita.Mieru.rust")
+    private var sockets: [UInt64: MieruSocket] = [:]
+    private var paused = Set<UInt64>()
+
+    init(engine: OpaquePointer) { self.engine = engine }
+
+    func open(stream: UInt64, host: String, port: UInt16, unsupported: Bool) {
+        self.queue.async {
+            guard !unsupported, port != 0 else {
+                MieruRuntime.shared.report(MieruError.unsupported.message)
+                self.reportClosed(stream: stream)
+                return
+            }
+            do {
+                let socket = try MieruRuntime.shared.makeSocket(queue: self.queue)
+                self.sockets.removeValue(forKey: stream)?.close()
+                self.sockets[stream] = socket
+                socket.connect(host: host, port: port, timeout: 15) { [weak self, weak socket] result in
+                    guard let self = self, let socket = socket, self.sockets[stream] === socket else { return }
+                    switch result {
+                    case .success:
+                        mt_stream_opened(self.engine, stream)
+                        self.receive(stream: stream, socket: socket)
+                    case let .failure(error): self.fail(stream: stream, error: error)
+                    }
+                }
+            } catch {
+                self.fail(stream: stream, error: error as? MieruError ?? .network)
+            }
+        }
+    }
+
+    func write(stream: UInt64, data: Data) {
+        self.queue.async {
+            guard let socket = self.sockets[stream] else { return }
+            socket.write(data) { [weak self, weak socket] result in
+                guard let self = self, let socket = socket, self.sockets[stream] === socket else { return }
+                switch result {
+                case .success: mt_stream_sent(self.engine, stream, data.count)
+                case let .failure(error): self.fail(stream: stream, error: error)
+                }
+            }
+        }
+    }
+
+    func close(stream: UInt64) {
+        self.queue.async {
+            self.paused.remove(stream)
+            self.sockets.removeValue(forKey: stream)?.close()
+        }
+    }
+
+    func resume(stream: UInt64) {
+        self.queue.async {
+            if self.paused.remove(stream) != nil, let socket = self.sockets[stream] {
+                self.receive(stream: stream, socket: socket)
+            }
+        }
+    }
+
+    private func receive(stream: UInt64, socket: MieruSocket) {
+        socket.read(maximum: 256 * 1024, timeout: -1) { [weak self, weak socket] result in
+            guard let self = self, let socket = socket, self.sockets[stream] === socket else { return }
+            switch result {
+            case let .success(data):
+                let more = data.withUnsafeBytes {
+                    mt_stream_received(self.engine, stream, MTBytes(data: $0.baseAddress?.assumingMemoryBound(to: UInt8.self), length: $0.count)) != 0
+                }
+                if more { self.receive(stream: stream, socket: socket) }
+                else { self.paused.insert(stream) }
+            case let .failure(error): self.fail(stream: stream, error: error)
+            }
+        }
+    }
+
+    private func fail(stream: UInt64, error: MieruError) {
+        self.paused.remove(stream)
+        self.sockets.removeValue(forKey: stream)?.close()
+        MieruRuntime.shared.report(error.message)
+        self.reportClosed(stream: stream)
+    }
+
+    private func reportClosed(stream: UInt64) {
+        "Mieru stream closed".withCString {
+            mt_stream_closed(self.engine, stream, MTString(data: $0, length: strlen($0)))
+        }
+    }
+
+    deinit { for socket in self.sockets.values { socket.close() } }
+}
