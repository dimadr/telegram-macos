diff --git a/crates/mtproto-engine/tests/required_host.rs b/crates/mtproto-engine/tests/required_host.rs
new file mode 100644
index 0000000..94ee702
--- /dev/null
+++ b/crates/mtproto-engine/tests/required_host.rs
@@ -0,0 +1,84 @@
+use std::io::ErrorKind;
+use std::net::TcpListener;
+use std::sync::{Arc, mpsc};
+use std::time::{Duration, Instant};
+
+use mtproto_core::rpc::SessionRole;
+use mtproto_engine::{DcAddress, Engine, EngineCallbacks, EngineConfig, EngineEvent, SessionHandle,
+    SessionSetup, StreamHost, StreamId, StreamTarget, TransportPreference};
+
+struct Callbacks;
+impl EngineCallbacks for Callbacks {
+    fn on_event(&self, _: SessionHandle, _: EngineEvent) {}
+}
+
+struct Host(mpsc::Sender<(StreamId, StreamTarget)>);
+impl StreamHost for Host {
+    fn open(&self, id: StreamId, target: &StreamTarget) { let _ = self.0.send((id, target.clone())); }
+    fn write(&self, _: StreamId, _: &[u8]) {}
+    fn close(&self, _: StreamId) {}
+    fn resume(&self, _: StreamId) {}
+}
+
+fn engine() -> Engine {
+    Engine::new(EngineConfig { worker_threads: 1, connect_timeout: 0.3,
+        max_reconnect_delay: 0.2, ..EngineConfig::default() }, Arc::new(Callbacks)).unwrap()
+}
+
+fn session(port: u16) -> SessionSetup {
+    let mut setup = SessionSetup::new(2, SessionRole::Main, vec![
+        DcAddress { host: "127.0.0.1".into(), port, secret: None },
+        DcAddress { host: "127.0.0.2".into(), port, secret: None }]);
+    setup.online = true;
+    setup.paused = false;
+    setup.transport = TransportPreference::Auto;
+    setup.http_port = Some(port);
+    setup
+}
+
+fn assert_no_connections(listener: &TcpListener, duration: Duration) {
+    let until = Instant::now() + duration;
+    while Instant::now() < until {
+        match listener.accept() {
+            Err(error) if error.kind() == ErrorKind::WouldBlock => {},
+            _ => panic!("required host stream opened a direct TCP/HTTP connection"),
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[test]
+fn required_tcp_uses_host_and_failure_cannot_race_or_probe_directly() {
+    let listener = TcpListener::bind("0.0.0.0:0").unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let engine = engine();
+    engine.require_stream_host(true);
+    let (sender, receiver) = mpsc::channel();
+    engine.set_stream_host(Some(Arc::new(Host(sender))));
+    let handle = engine.create_session(session(listener.local_addr().unwrap().port()));
+    let (id, target) = receiver.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert!(!target.carrier);
+    assert!(target.tls_server_name.is_none());
+    assert!(target.host.starts_with("127.0.0."));
+    engine.stream_opened(id);
+    assert_no_connections(&listener, Duration::from_secs(2));
+    engine.stream_closed(id, Some("test transport failure".into()));
+    engine.set_stream_host(None);
+    assert_no_connections(&listener, Duration::from_secs(2));
+    engine.destroy_session(handle);
+}
+
+#[test]
+fn missing_required_host_and_explicit_http_fail_closed() {
+    let listener = TcpListener::bind("0.0.0.0:0").unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let engine = engine();
+    engine.require_stream_host(true);
+    let mut setup = session(listener.local_addr().unwrap().port());
+    let tcp = engine.create_session(setup.clone());
+    setup.transport = TransportPreference::Http;
+    let http = engine.create_session(setup);
+    assert_no_connections(&listener, Duration::from_secs(2));
+    engine.destroy_session(tcp);
+    engine.destroy_session(http);
+}
